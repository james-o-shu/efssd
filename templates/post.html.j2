{% extends "base.html.j2" %}

{% block title %}{{ post.title }}{% endblock %}

{% block content %}
  <article class="card">
    <h1>{{ post.title }}</h1>
    <p class="meta"><strong>By:</strong> {{ post.author }} • {{ post.date }}</p>
    <p>{{ post.content }}</p>
    <p><a href="/">Back to posts</a></p>
  </article>
{% endblock %}
